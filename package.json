{
  "name": "n8n-nodes-fingrid",
  "version": "0.1.0",
  "description": "n8n community node for Fingrid Open Data — Finnish power grid and electricity market data",
  "keywords": [
    "n8n-community-node-package",
    "fingrid",
    "electricity",
    "power-grid",
    "finland",
    "energy"
  ],
  "license": "MIT",
  "homepage": "https://github.com/MychelGarzon/n8n-nodes-fingrid",
  "author": {
    "name": "Mychel Garzon"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MychelGarzon/n8n-nodes-fingrid.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && npx gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials package.json",
    "test": "jest "
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FingridApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Fingrid/Fingrid.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/parser": "~8.32.0",
    "eslint": "8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "jest": "^30.4.2",
    "n8n-core": "^1.14.1",
    "n8n-workflow": "^1.82.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.15"
  }
}
